# Railway la inyecta automáticamente al vincular el plugin de Postgres.
# Para desarrollo local, copia este archivo a .env y ajusta los valores.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/githouse

# Secreto para poder llamar POST /admin/recargar-datos sin redeploy.
# Cambialo por uno fuerte en las variables de entorno de Railway.
ADMIN_SECRET=changeme

# Umbral mínimo (0-100) de similitud para dar una respuesta como válida.
MATCH_THRESHOLD=62

# Cuántas sugerencias alternativas devolver cuando no hay match claro.
MAX_SUGERENCIAS=3

APP_ENV=production

# --- WhatsApp (Green API) ---
WHATSAPP_API_URL=https://api.green-api.com
WHATSAPP_INSTANCE_ID=
WHATSAPP_API_TOKEN=
